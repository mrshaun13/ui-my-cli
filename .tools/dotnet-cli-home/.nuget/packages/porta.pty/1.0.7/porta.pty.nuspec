<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Porta.Pty</id>
    <version>1.0.7</version>
    <authors>Tom Laird-McConnell</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/tomlm/Porta.Pty</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/tomlm/Porta.Pty/master/icon.png</iconUrl>
    <description>Cross platform (windows/linux/macos) Pty library for communicating with console applications. Uses native shim for .NET 7+ compatibility (no DOTNET_EnableWriteXorExecute required).</description>
    <copyright>Tom Laird-McConnell All Rights Reserved</copyright>
    <repository type="git" url="https://github.com/tomlm/Porta.Pty" commit="54684ba55148ed6bcd0c827ad7e8841a3289a466" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Vanara.PInvoke.Kernel32" version="4.2.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>