<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Unicode.net</id>
    <version>2.0.0</version>
    <authors>Mahmoud Al-Qudsi, neosmart</authors>
    <license type="file">LICENSE</license>
    <licenseUrl>https://aka.ms/deprecateLicenseUrl</licenseUrl>
    <projectUrl>https://github.com/neosmart/unicode.net</projectUrl>
    <description>A Unicode and emoji text-processing library for .NET, supporting UTF-8, UTF-16, and UTF-32 on .NET 2.0+ and .NET Standard (Core/UWP), with emoji support! 🔥🌶️😁🎉</description>
    <releaseNotes>Initial release, including emoji support 🔥🌶️😁🎉!</releaseNotes>
    <copyright>Copyright NeoSmart Technologies 2017 - 2021</copyright>
    <tags>unicode, text processing, encoding, utf8, utf-8, utf-16, utf16, utf-32, utf32, emoji, emojis</tags>
    <repository type="git" url="https://github.com/neosmart/unicode.net" commit="43e575d4f38267b3c41a869a1b7cc0708c30db76" />
    <dependencies>
      <group targetFramework=".NETFramework2.0">
        <dependency id="LinqBridge" version="1.3.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.0" />
      <group targetFramework=".NETStandard1.3">
        <dependency id="NETStandard.Library" version="1.6.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1" />
    </dependencies>
  </metadata>
</package>