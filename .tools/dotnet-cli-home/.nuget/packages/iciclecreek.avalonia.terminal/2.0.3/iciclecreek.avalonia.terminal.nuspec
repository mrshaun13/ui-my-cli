<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Iciclecreek.Avalonia.Terminal</id>
    <version>2.0.3</version>
    <authors>Tom Laird-McConnell</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/tomlm/Iciclecreek.Avalonia.Terminal</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/tomlm/Iciclecreek.Avalonia.Terminal/master/icon.png</iconUrl>
    <description>Avalonia terminal controls (TerminalControl/TerminalWindow) that provide an XTerm console for hosting console applications in Avalonia.</description>
    <copyright>Tom Laird-McConnell All Rights Reserved</copyright>
    <repository type="git" url="https://github.com/tomlm/Iciclecreek.Avalonia.Terminal" commit="158e010fb6dfa0075d3035c4fbecfe965ffc3a06" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Avalonia" version="12.0.2" exclude="Build,Analyzers" />
        <dependency id="Porta.Pty" version="1.0.7" exclude="Build,Analyzers" />
        <dependency id="Unicode.net" version="2.0.0" exclude="Build,Analyzers" />
        <dependency id="Wcwidth" version="4.0.1" exclude="Build,Analyzers" />
        <dependency id="XTerm.NET" version="1.0.14" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Avalonia" version="12.0.2" exclude="Build,Analyzers" />
        <dependency id="Porta.Pty" version="1.0.7" exclude="Build,Analyzers" />
        <dependency id="Unicode.net" version="2.0.0" exclude="Build,Analyzers" />
        <dependency id="Wcwidth" version="4.0.1" exclude="Build,Analyzers" />
        <dependency id="XTerm.NET" version="1.0.14" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>