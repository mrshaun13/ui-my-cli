#!/bin/sh
# ── Personal pre-push hook delegation ──────────────────────────────────────
#
# If you need custom pre-push behaviour (e.g. pushing to a second remote with
# a different identity), place your script at:
#
#   ~/.config/git/hooks/ui-my-cli-pre-push
#
# This stub will source it automatically.  It receives the same $1 (remote)
# and $2 (url) args that git passes, plus stdin with ref/sha lines.
#
# If the file doesn't exist, this hook is a no-op (exit 0).

PERSONAL_HOOK="$HOME/.config/git/hooks/ui-my-cli-pre-push"

if [ -x "$PERSONAL_HOOK" ]; then
  exec "$PERSONAL_HOOK" "$@"
fi

exit 0
