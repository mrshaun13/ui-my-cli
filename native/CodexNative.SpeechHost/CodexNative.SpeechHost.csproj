<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CodexNative.SpeechHost</AssemblyName>
    <RootNamespace>CodexNative.SpeechHost</RootNamespace>
    <WhisperNetVersion>1.9.1</WhisperNetVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SoundFlow" Version="1.4.1" />
    <PackageReference Include="Whisper.net" Version="$(WhisperNetVersion)" />
    <PackageReference Include="Whisper.net.Runtime" Version="$(WhisperNetVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CodexNative.Core/CodexNative.Core.csproj" />
  </ItemGroup>
</Project>
