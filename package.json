{
  "name": "devin-dashboard",
  "version": "1.0.0",
  "description": "Browser-based dashboard for managing Devin CLI agent sessions",
  "private": true,
  "scripts": {
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:restart": "npm run build && pm2 restart devin-dashboard",
    "pm2:stop": "pm2 stop devin-dashboard",
    "pm2:logs": "pm2 logs devin-dashboard",
    "postinstall": "cd client && npm install",
    "docs": "node scripts/generate-docs.js",
    "docs:check": "node scripts/generate-docs.js --check",
    "test": "npx playwright test",
    "test:smoke": "npx playwright test tests/smoke.spec.js",
    "prepare": "husky"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "node-pty": "^1.0.0",
    "ws": "^8.16.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "husky": "^9.1.7"
  }
}
